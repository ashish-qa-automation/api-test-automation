<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Regression" verbose="1" parallel="methods" thread-count="3" data-provider-thread-count="1">
    <listeners>
        <listener class-name="com.ashishqa.api.listeners.AllureEnvironmentListener"/>
        <listener class-name="com.ashishqa.api.listeners.FailureInsightListener"/>
    </listeners>
    <test name="BookingRegression">
        <groups>
            <run>
                <include name="smoke"/>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.ashishqa.demo.booker.tests.BookingCrudWorkflowTest"/>
            <class name="com.ashishqa.demo.booker.tests.BookingRegressionTest"/>
        </classes>
    </test>
</suite>

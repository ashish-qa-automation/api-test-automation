<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Smoke" verbose="1" parallel="methods" thread-count="3" data-provider-thread-count="1">
    <listeners>
        <listener class-name="com.ashishqa.api.listeners.AllureEnvironmentListener"/>
        <listener class-name="com.ashishqa.api.listeners.FailureInsightListener"/>
    </listeners>
    <!-- Every method in this suite is in the smoke group. No retry analyzer. -->
    <test name="Smoke">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.ashishqa.api.tests.FrameworkSmokeTest"/>
            <class name="com.ashishqa.api.config.ConfigLoaderTest"/>
            <class name="com.ashishqa.api.authentication.AuthStrategiesTest"/>
            <class name="com.ashishqa.api.authentication.ThreadLocalTokenProviderTest"/>
            <class name="com.ashishqa.api.logging.SensitiveDataRedactorTest"/>
            <class name="com.ashishqa.api.logging.CorrelationIdTest"/>
            <class name="com.ashishqa.api.reporting.AllureEnvironmentTest"/>
            <class name="com.ashishqa.api.reporting.AllureRedactionTest"/>
            <class name="com.ashishqa.api.listeners.FailureInsightTest"/>
            <class name="com.ashishqa.api.serialization.JsonCodecTest"/>
            <class name="com.ashishqa.api.utilities.ClasspathResourceTest"/>
            <class name="com.ashishqa.api.assertions.HttpAssertTest"/>
            <class name="com.ashishqa.demo.booker.assertions.BookerErrorAssertTest"/>
            <class name="com.ashishqa.demo.booker.tests.BookingHealthCheckTest"/>
            <class name="com.ashishqa.demo.booker.tests.BookingAuthTest"/>
            <class name="com.ashishqa.demo.booker.tests.BookingPayloadTest"/>
            <class name="com.ashishqa.demo.booker.tests.BookingContractTest"/>
            <class name="com.ashishqa.demo.booker.tests.BookingCrudWorkflowTest"/>
        </classes>
    </test>
</suite>
